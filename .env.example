# Vercel > Project Settings > Environment Variables (Production / Preview as needed)
# Names contain underscores, not spaces. Values must come from the same project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# No ADMIN_PASSWORD or SUPABASE_SERVICE_ROLE_KEY is needed.
